#--------------------------------------------------------------------
# Environment Configuration Example
#--------------------------------------------------------------------
# Copy this file to .env and update the values for your environment
# This file shows what environment variables are available

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/newsoft/base_app/'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# EMAIL CONFIGURATION
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = mail.yourdomain.com
email.SMTPUser = support@yourdomain.com
email.SMTPPass = your_email_password_here
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.fromEmail = support@yourdomain.com
email.fromName = Your Company Name

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate a secure encryption key (32 characters)
# You can use: bin2hex(random_bytes(32))
encryption.key = your_encryption_key_here_32_chars

#--------------------------------------------------------------------
# PAYMENT GATEWAY - MIDTRANS
#--------------------------------------------------------------------
midtrans.serverKey = your_midtrans_server_key
midtrans.clientKey = your_midtrans_client_key
midtrans.isProduction = false

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.cookieName = 'ci_session'
# session.expiration = 7200
# session.savePath = null
# session.matchIP = false
# session.timeToUpdate = 300
# session.regenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
# csrf.tokenName = 'csrf_token_name'
# csrf.headerName = 'X-CSRF-TOKEN'
# csrf.cookieName = 'csrf_cookie_name'
# csrf.expires = 7200
# csrf.regenerate = true
# csrf.redirect = true

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------
# cache.handler = 'file'
# cache.storePath = writable/cache/

#--------------------------------------------------------------------
# CUSTOM APPLICATION SETTINGS
#--------------------------------------------------------------------
# Add your custom environment variables below
# whatsapp.apiKey = your_wa_api_key
# whatsapp.apiUrl = https://api.whatsapp.com/

#--------------------------------------------------------------------
# WHATSAPP NOTIFICATION
#--------------------------------------------------------------------
# Konfigurasi berikut mengikuti payload helper lama yang sudah ada
# di project dengan field `api_key`, `number_key`, dan `phone_no`.
whatsapp.apiUrl = https://whatsapp-endpoint.watzap.id/api/send-message
whatsapp.apiKey = your_whatsapp_api_key
whatsapp.numberKey = your_whatsapp_number_key
whatsapp.defaultRecipient = 628558000986
whatsapp.waitUntilSend = 1

#--------------------------------------------------------------------
# FOREX MONITORING
#--------------------------------------------------------------------
# API key gratis Alpha Vantage dipakai module Forex Monitor/Report
# untuk mengambil data OHLC harian GBP/JPY dengan endpoint FX_DAILY.
forex.alphaVantageApiKey = your_alpha_vantage_api_key
# Provider tambahan berikut bersifat opsional untuk quote/chart realtime
# sehingga dashboard tetap bisa memakai fallback publik bila key kosong.
forex.twelveDataApiKey =
forex.finnhubApiKey =
forex.oandaApiUrl = https://api-fxpractice.oanda.com/v3
forex.oandaAccountId =
forex.oandaAccessToken =
# TTL cache realtime dibuat pendek agar polling 30 detik tetap hemat request.
forex.dashboardQuoteCacheTtl = 25
forex.dashboardChartCacheTtl = 300
forex.dashboardHistoryWarmCacheTtl = 21600
forex.newYorkSessionTimezone = America/New_York
forex.newYorkSessionOpenHour = 8
forex.newYorkSessionActiveEndHour = 17
